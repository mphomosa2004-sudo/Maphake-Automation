/* ============================================
   MAPHAKE AUTOMATION — SHARED STYLESHEET
   Gold & Black luxury agency theme
   ============================================ */

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --gold:#C9A84C;
  --gold-light:#F0C96B;
  --gold-dim:#8A6E2A;
  --black:#0A0A0A;
  --black-2:#111111;
  --black-3:#1A1A1A;
  --black-4:#222222;
  --white:#F5F0E8;
  --white-pure:#FFFFFF;
  --text-muted:#888880;
  --border:#2A2A2A;
}

html{scroll-behavior:smooth}
body{
  background:var(--black);
  color:var(--white);
  font-family:'DM Sans',sans-serif;
  font-size:16px;
  line-height:1.7;
  overflow-x:hidden;
  min-height:100vh;
}

a{color:inherit}
img{max-width:100%;display:block}

/* ============================================
   CUSTOM CURSOR + TRAIL (desktop only)
   ============================================ */
#cursor{position:fixed;width:10px;height:10px;border-radius:50%;background:var(--gold);pointer-events:none;z-index:99999;transform:translate(-50%,-50%);mix-blend-mode:difference;transition:width .15s,height .15s}
#cursor-ring{position:fixed;width:34px;height:34px;border-radius:50%;border:1px solid rgba(201,168,76,0.5);pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:left .12s ease,top .12s ease}
.trail-dot{position:fixed;width:6px;height:6px;border-radius:50%;background:var(--gold);pointer-events:none;z-index:99997;transform:translate(-50%,-50%);opacity:.7}

/* ============================================
   PAGE LOADER — robot running in place
   ============================================ */
#loader{position:fixed;inset:0;background:var(--black);z-index:100000;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}
#loader-stage{position:relative;width:160px;height:180px;display:flex;align-items:center;justify-content:center}
#loader-robot{width:150px;height:150px;object-fit:contain;animation:robotBob .45s ease-in-out infinite alternate}
@keyframes robotBob{
  0%{transform:translateY(0) rotate(-2deg)}
  100%{transform:translateY(-14px) rotate(2deg)}
}
/* speed lines running past the robot to simulate motion */
.speed-line{position:absolute;height:2px;background:linear-gradient(to left,var(--gold),transparent);border-radius:2px;opacity:0;animation:speed 0.6s linear infinite}
@keyframes speed{
  0%{transform:translateX(60px);opacity:0}
  30%{opacity:.8}
  100%{transform:translateX(-120px);opacity:0}
}
#loader-text{font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,5vw,40px);letter-spacing:6px;color:var(--gold);margin-top:28px;text-align:center}
#loader-sub{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--text-muted);margin-top:6px;text-align:center}
#loader-track{position:absolute;bottom:0;left:0;height:3px;background:var(--gold);width:0;animation:loadTrack 1.4s ease forwards}
@keyframes loadTrack{to{width:100%}}
#loader.hide{opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s ease}

/* ============================================
   NAV
   ============================================ */
nav{position:fixed;top:0;left:0;right:0;z-index:9000;padding:0 6vw;height:70px;display:flex;align-items:center;justify-content:space-between;background:rgba(10,10,10,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);transition:height .3s}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo img{width:40px;height:40px;object-fit:contain;border-radius:50%}
.nav-logo-text{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;color:var(--gold)}
.nav-logo-text span{color:var(--white)}
.nav-links{display:flex;align-items:center;gap:30px;list-style:none}
.nav-links a{color:var(--text-muted);text-decoration:none;font-size:14px;font-weight:500;letter-spacing:.5px;transition:color .2s}
.nav-links a:hover,.nav-links a.active{color:var(--gold)}
.nav-cta{background:var(--gold);color:var(--black) !important;padding:9px 22px;border-radius:2px;font-weight:600;font-size:13px;letter-spacing:.5px;transition:background .2s !important}
.nav-cta:hover{background:var(--gold-light) !important}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none}
.hamburger span{display:block;width:24px;height:2px;background:var(--white);transition:all .3s}

@media(max-width:860px){
  .nav-links{display:none;position:fixed;top:70px;left:0;right:0;background:var(--black-2);flex-direction:column;padding:24px;gap:16px;border-bottom:1px solid var(--border)}
  .nav-links.open{display:flex}
  .hamburger{display:flex}
  .nav-links .nav-cta{text-align:center;padding:12px 22px}
}

/* ============================================
   BUTTONS
   ============================================ */
.btn-primary{background:var(--gold);color:var(--black);padding:14px 32px;border-radius:2px;font-weight:700;font-size:14px;text-decoration:none;letter-spacing:.5px;transition:all .2s;display:inline-block;border:none;cursor:pointer;font-family:'DM Sans',sans-serif}
.btn-primary:hover{background:var(--gold-light)}
.btn-outline{border:1px solid var(--gold);color:var(--gold);padding:14px 32px;border-radius:2px;font-weight:600;font-size:14px;text-decoration:none;letter-spacing:.5px;transition:all .2s;display:inline-block;background:none;cursor:pointer;font-family:'DM Sans',sans-serif}
.btn-outline:hover{background:rgba(201,168,76,0.08)}

/* ============================================
   GLOBAL ANIMATED BACKGROUND (canvas)
   ============================================ */
#bg-canvas{position:fixed;inset:0;z-index:-2;pointer-events:none}
#bg-glow{position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 20% 30%,rgba(201,168,76,0.06),transparent 40%),radial-gradient(circle at 80% 70%,rgba(201,168,76,0.05),transparent 40%)}

/* ============================================
   PAGE HERO (inner pages)
   ============================================ */
.page-hero{padding:160px 6vw 80px;position:relative;border-bottom:1px solid var(--border)}
.page-hero .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:20px}
.page-hero .eyebrow::before{content:'';display:block;width:32px;height:1px;background:var(--gold)}
.page-hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(48px,8vw,90px);line-height:.95;letter-spacing:1px;color:var(--white-pure);margin-bottom:16px}
.page-hero h1 .gold{color:var(--gold)}
.page-hero p{font-size:clamp(16px,2vw,19px);color:var(--text-muted);max-width:600px;line-height:1.65}

/* ============================================
   HOMEPAGE HERO
   ============================================ */
.hero{min-height:100vh;display:flex;align-items:center;position:relative;padding:120px 6vw 80px;overflow:hidden}
.hero-slash{position:absolute;top:0;right:0;width:3px;height:100%;background:linear-gradient(to bottom,transparent,var(--gold),transparent);opacity:.4}
.hero-robot{position:absolute;right:2vw;bottom:0;height:88vh;max-height:780px;object-fit:contain;pointer-events:none;z-index:1;opacity:.92;filter:drop-shadow(0 0 40px rgba(201,168,76,0.15))}
.hero-content{max-width:760px;position:relative;z-index:2}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:28px}
.hero-eyebrow::before{content:'';display:block;width:32px;height:1px;background:var(--gold)}
.hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,9vw,108px);line-height:.95;letter-spacing:1px;color:var(--white-pure);margin-bottom:8px}
.hero h1 .gold{color:var(--gold)}
.hero-sub{font-size:clamp(16px,2vw,20px);color:var(--text-muted);max-width:540px;margin:24px 0 44px;line-height:1.65}
.hero-actions{display:flex;gap:16px;flex-wrap:wrap}
.hero-stats{display:flex;gap:40px;margin-top:60px;padding-top:36px;border-top:1px solid var(--border);flex-wrap:wrap}
.stat-item .num{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--gold);letter-spacing:1px}
.stat-item .lbl{font-size:12px;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;margin-top:2px}
@media(max-width:860px){
  .hero-robot{opacity:.20;right:-10vw}
}

/* ============================================
   SCROLL REVEAL
   ============================================ */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .7s ease,transform .7s ease}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(40px);transition:opacity .7s ease,transform .7s ease}
.reveal-right.visible{opacity:1;transform:translateX(0)}
.stagger-1{transition-delay:.1s}.stagger-2{transition-delay:.2s}.stagger-3{transition-delay:.3s}.stagger-4{transition-delay:.4s}.stagger-5{transition-delay:.5s}.stagger-6{transition-delay:.6s}.stagger-7{transition-delay:.7s}.stagger-8{transition-delay:.8s}

/* ============================================
   SECTIONS
   ============================================ */
section{padding:100px 6vw;position:relative}
.section-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:16px}
.section-eyebrow::before{content:'';display:block;width:24px;height:1px;background:var(--gold)}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,6vw,72px);line-height:1;color:var(--white-pure);margin-bottom:16px;letter-spacing:1px}
.section-subtitle{color:var(--text-muted);font-size:17px;max-width:540px;line-height:1.65}

/* ============================================
   MARQUEE
   ============================================ */
.marquee-section{padding:0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--black-2);overflow:hidden}
.marquee-track{display:flex;white-space:nowrap;animation:marquee 22s linear infinite}
.marquee-item{padding:18px 48px;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--text-muted);font-weight:600;border-right:1px solid var(--border);flex-shrink:0}
.marquee-item .dot{color:var(--gold);margin-right:12px}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ============================================
   SERVICES GRID
   ============================================ */
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:var(--border);margin-top:64px}
.service-card{background:var(--black);padding:40px 36px;position:relative;overflow:hidden;transition:background .3s}
.service-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:0;background:var(--gold);transition:height .4s}
.service-card:hover{background:var(--black-2)}
.service-card:hover::before{height:100%}
.service-icon{font-size:13px;letter-spacing:2px;font-weight:700;color:var(--gold);margin-bottom:20px;border:1px solid var(--gold-dim);display:inline-block;padding:6px 10px}
.service-card h3{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;color:var(--white-pure);margin-bottom:10px}
.service-card p{font-size:14px;color:var(--text-muted);line-height:1.7}

/* ============================================
   ABOUT
   ============================================ */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;margin-top:64px}
@media(max-width:860px){.about-grid{grid-template-columns:1fr;gap:40px}}
.about-text p{color:var(--text-muted);font-size:16px;line-height:1.8;margin-bottom:16px}
.about-text p:first-child{color:var(--white);font-size:18px}
.about-values{border:1px solid var(--border)}
.value-row{display:flex;gap:20px;padding:24px 28px;border-bottom:1px solid var(--border);align-items:flex-start;transition:background .3s}
.value-row:last-child{border-bottom:none}
.value-row:hover{background:var(--black-3)}
.value-num{font-family:'Bebas Neue',sans-serif;font-size:32px;color:var(--gold);line-height:1;flex-shrink:0;width:40px}
.value-row h4{font-weight:600;font-size:15px;color:var(--white-pure);margin-bottom:4px}
.value-row p{font-size:13px;color:var(--text-muted);line-height:1.6}

/* ============================================
   PACKAGES
   ============================================ */
.packages-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2px;background:var(--border);margin-top:64px}
.pkg-card{background:var(--black);padding:44px 36px;position:relative;transition:background .3s}
.pkg-card:hover{background:var(--black-2)}
.pkg-card.featured{background:var(--black-2)}
.pkg-badge{display:inline-block;background:var(--gold);color:var(--black);font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;margin-bottom:20px}
.pkg-name{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:1px;color:var(--white-pure);margin-bottom:8px}
.pkg-price{font-family:'Bebas Neue',sans-serif;font-size:52px;color:var(--gold);line-height:1;margin-bottom:4px}
.pkg-price span{font-size:20px;color:var(--text-muted)}
.pkg-note{font-size:12px;color:var(--text-muted);margin-bottom:28px}
.pkg-divider{height:1px;background:var(--border);margin-bottom:24px}
.pkg-features{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:36px}
.pkg-features li{font-size:14px;color:var(--text-muted);padding-left:18px;position:relative}
.pkg-features li::before{content:'→';position:absolute;left:0;color:var(--gold);font-size:12px;top:3px}
.pkg-card .btn-primary,.pkg-card .btn-outline{width:100%;text-align:center;display:block}

.payment-note{background:var(--black-3);border:1px solid var(--border);border-left:3px solid var(--gold);padding:18px 22px;margin-top:32px;font-size:13px;color:var(--text-muted);line-height:1.65}
.payment-note strong{color:var(--gold)}

/* ============================================
   ADD-ONS
   ============================================ */
.addons-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--border);margin-top:64px}
.addon-item{background:var(--black);padding:28px 24px;transition:background .3s}
.addon-item:hover{background:var(--black-3)}
.addon-price{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--gold);margin-bottom:6px}
.addon-item h4{font-size:15px;font-weight:600;color:var(--white-pure);margin-bottom:4px}
.addon-item p{font-size:13px;color:var(--text-muted)}

/* ============================================
   AI SECTION
   ============================================ */
.ai-section{position:relative;overflow:hidden}
.ai-bg-text{position:absolute;right:-2vw;top:50%;transform:translateY(-50%);font-family:'Bebas Neue',sans-serif;font-size:clamp(160px,25vw,320px);color:rgba(201,168,76,0.04);letter-spacing:5px;pointer-events:none;line-height:1;user-select:none}
.ai-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:2;margin-top:64px}
@media(max-width:860px){.ai-grid{grid-template-columns:1fr;gap:40px}}
.ai-features{display:flex;flex-direction:column;gap:24px}
.ai-feat{display:flex;gap:16px;align-items:flex-start}
.ai-feat-icon{width:40px;height:40px;border:1px solid var(--gold-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--gold);font-weight:700;font-family:'Bebas Neue',sans-serif;letter-spacing:1px}
.ai-feat h4{font-weight:600;font-size:15px;color:var(--white-pure);margin-bottom:4px}
.ai-feat p{font-size:14px;color:var(--text-muted);line-height:1.65}
.ai-demo-box{background:var(--black-2);border:1px solid var(--border);padding:32px;border-top:3px solid var(--gold)}
.ai-demo-box h3{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;color:var(--white-pure);margin-bottom:20px}
.chat-bubble{background:var(--black-3);padding:12px 16px;margin-bottom:10px;font-size:14px;color:var(--text-muted)}
.chat-bubble.bot{border-left:2px solid var(--gold);color:var(--white)}
.chat-bubble .sender{font-size:10px;letter-spacing:1px;text-transform:uppercase;font-weight:600;margin-bottom:4px}
.chat-bubble.user .sender{color:var(--text-muted)}
.chat-bubble.bot .sender{color:var(--gold)}

/* ============================================
   PORTFOLIO
   ============================================ */
.portfolio-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2px;background:var(--border);margin-top:64px}
.portfolio-card{background:var(--black);padding:40px 36px;position:relative;overflow:hidden;transition:background .3s}
.portfolio-card:hover{background:var(--black-3)}
.portfolio-tag{display:inline-block;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:16px;border:1px solid var(--gold-dim);padding:3px 10px}
.portfolio-card h3{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;color:var(--white-pure);margin-bottom:8px}
.portfolio-card .location{font-size:12px;color:var(--text-muted);margin-bottom:12px}
.portfolio-card p{font-size:14px;color:var(--text-muted);line-height:1.65;margin-bottom:24px}
.portfolio-tech{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:24px}
.portfolio-tech span{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--text-muted);border:1px solid var(--border);padding:3px 8px}
.portfolio-link{font-size:13px;color:var(--gold);text-decoration:none;font-weight:600;display:inline-flex;align-items:center;gap:6px}
.portfolio-link:hover{text-decoration:underline}

/* ============================================
   PROCESS
   ============================================ */
.process-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:64px;border:1px solid var(--border)}
@media(max-width:900px){.process-steps{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.process-steps{grid-template-columns:1fr}}
.process-step{padding:36px 28px;border-right:1px solid var(--border);transition:background .3s}
.process-step:last-child{border-right:none}
.process-step:hover{background:var(--black-2)}
@media(max-width:900px){.process-step{border-right:1px solid var(--border);border-bottom:1px solid var(--border)}}
.process-step .step-num{font-family:'Bebas Neue',sans-serif;font-size:52px;color:rgba(201,168,76,0.15);line-height:1;margin-bottom:12px}
.process-step h4{font-weight:600;font-size:15px;color:var(--white-pure);margin-bottom:8px}
.process-step p{font-size:13px;color:var(--text-muted);line-height:1.65}

/* ============================================
   FAQ
   ============================================ */
.faq-list{margin-top:64px;border:1px solid var(--border)}
.faq-item{border-bottom:1px solid var(--border)}
.faq-item:last-child{border-bottom:none}
.faq-q{width:100%;background:none;border:none;padding:24px 28px;text-align:left;cursor:pointer;color:var(--white);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:500;display:flex;justify-content:space-between;align-items:center;gap:16px;transition:background .2s}
.faq-q:hover{background:var(--black-3)}
.faq-q .arrow{color:var(--gold);font-size:20px;transition:transform .3s;flex-shrink:0}
.faq-q.open .arrow{transform:rotate(45deg)}
.faq-a{display:none;padding:0 28px 24px;color:var(--text-muted);font-size:15px;line-height:1.75}
.faq-a.open{display:block}

/* ============================================
   CTA BANNER
   ============================================ */
.cta-banner{background:var(--gold);padding:80px 6vw;text-align:center;position:relative;overflow:hidden}
.cta-banner::before{content:'M';position:absolute;font-family:'Bebas Neue',sans-serif;font-size:40vw;color:rgba(0,0,0,0.06);left:50%;top:50%;transform:translate(-50%,-50%);pointer-events:none;line-height:1}
.cta-banner h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(42px,7vw,80px);color:var(--black);letter-spacing:1px;line-height:1;margin-bottom:16px;position:relative}
.cta-banner p{color:rgba(10,10,10,0.65);font-size:17px;max-width:500px;margin:0 auto 36px;position:relative}
.btn-dark{background:var(--black);color:var(--gold);padding:16px 40px;border-radius:2px;font-weight:700;font-size:14px;text-decoration:none;letter-spacing:.5px;display:inline-block;transition:background .2s;position:relative}
.btn-dark:hover{background:var(--black-2)}

/* ============================================
   CONTACT
   ============================================ */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;margin-top:64px;align-items:start}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr;gap:40px}}
.contact-info{display:flex;flex-direction:column;gap:28px}
.contact-info-item{display:flex;gap:16px;align-items:flex-start}
.ci-icon{width:40px;height:40px;border:1px solid var(--gold-dim);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:16px;flex-shrink:0}
.contact-info-item h4{font-weight:600;font-size:14px;color:var(--white-pure);margin-bottom:2px}
.contact-info-item a,.contact-info-item p{font-size:14px;color:var(--text-muted);text-decoration:none}
.contact-info-item a:hover{color:var(--gold)}
.contact-form{display:flex;flex-direction:column;gap:16px}
.contact-form label{font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--text-muted);margin-bottom:-8px}
.contact-form input,.contact-form select,.contact-form textarea{background:var(--black-3);border:1px solid var(--border);color:var(--white);padding:14px 16px;font-family:'DM Sans',sans-serif;font-size:15px;width:100%;outline:none;transition:border-color .2s;border-radius:0;-webkit-appearance:none}
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--gold)}
.contact-form select option{background:var(--black-3)}
.contact-form textarea{resize:vertical;min-height:130px}
.contact-form input::placeholder,.contact-form textarea::placeholder{color:var(--text-muted)}
.field-error{color:#E2A04B;font-size:12px;margin-top:-8px;display:none}
.field-error.show{display:block}
#cf-status{font-size:13px;color:var(--gold);display:none;text-align:center;padding-top:8px}

/* ============================================
   FOOTER
   ============================================ */
footer{background:var(--black-2);border-top:1px solid var(--border);padding:64px 6vw 32px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px}
@media(max-width:900px){.footer-grid{grid-template-columns:1fr 1fr;gap:32px}}
@media(max-width:600px){.footer-grid{grid-template-columns:1fr}}
.footer-brand .logo-line{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.footer-brand .logo-line img{width:36px;height:36px;border-radius:50%}
.footer-brand .logo{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;color:var(--gold)}
.footer-brand .logo span{color:var(--white)}
.footer-brand p{font-size:13px;color:var(--text-muted);line-height:1.7;max-width:260px;margin-bottom:20px}
.footer-social{display:flex;gap:10px}
.footer-social a{width:34px;height:34px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:11px;font-weight:700;text-decoration:none;transition:all .2s}
.footer-social a:hover{border-color:var(--gold);color:var(--gold)}
.footer-col h4{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:16px;font-weight:600}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.footer-col ul a{font-size:14px;color:var(--text-muted);text-decoration:none;transition:color .2s}
.footer-col ul a:hover{color:var(--white)}
.footer-bottom{border-top:1px solid var(--border);padding-top:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.footer-bottom p{font-size:12px;color:var(--text-muted)}
.footer-bottom a{color:var(--text-muted);text-decoration:none;font-size:12px}
.footer-bottom a:hover{color:var(--gold)}

/* ============================================
   AI CHAT WIDGET
   ============================================ */
#ai-widget{position:fixed;bottom:28px;right:28px;z-index:9500}
#ai-prompt-bubble{position:absolute;bottom:8px;right:74px;background:var(--black-2);border:1px solid var(--gold-dim);border-radius:6px;padding:12px 16px;width:230px;font-size:13px;color:var(--white);line-height:1.5;box-shadow:0 8px 30px rgba(0,0,0,0.5);animation:bubbleIn .4s ease}
#ai-prompt-bubble::after{content:'';position:absolute;right:-7px;bottom:18px;width:0;height:0;border-top:7px solid transparent;border-bottom:7px solid transparent;border-left:7px solid var(--gold-dim)}
#ai-prompt-bubble strong{color:var(--gold)}
#ai-prompt-close{position:absolute;top:4px;right:6px;background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:13px}
@keyframes bubbleIn{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:translateX(0)}}
@media(max-width:560px){#ai-prompt-bubble{display:none}}

#ai-toggle{width:60px;height:60px;border-radius:50%;background:var(--gold);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 24px rgba(201,168,76,0.4);transition:all .2s;font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;color:var(--black);font-weight:700}
#ai-toggle:hover{background:var(--gold-light);transform:scale(1.08)}
#ai-toggle.active{background:var(--black-2);color:var(--gold);border:1px solid var(--gold)}

#ai-box{display:none;position:absolute;bottom:74px;right:0;width:360px;max-width:calc(100vw - 40px);background:var(--black-2);border:1px solid var(--border);border-top:3px solid var(--gold);flex-direction:column;overflow:hidden;box-shadow:0 12px 50px rgba(0,0,0,0.6)}
#ai-box.open{display:flex;animation:slideUp .3s ease}
@keyframes slideUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
#ai-header{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:var(--black-3)}
.ai-header-left{display:flex;align-items:center;gap:10px}
.ai-header-badge{width:30px;height:30px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:14px;color:var(--black);font-weight:700;letter-spacing:1px}
.ai-name{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px;color:var(--gold)}
.ai-sub{font-size:10px;color:var(--text-muted);letter-spacing:.5px}
.ai-close{background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:18px;padding:2px;line-height:1;transition:color .2s}
.ai-close:hover{color:var(--white)}
#ai-messages{height:300px;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
#ai-messages::-webkit-scrollbar{width:4px}
#ai-messages::-webkit-scrollbar-track{background:var(--black)}
#ai-messages::-webkit-scrollbar-thumb{background:var(--border)}
.ai-msg{padding:10px 14px;font-size:13px;line-height:1.6;max-width:92%;word-wrap:break-word}
.ai-msg.bot{background:var(--black-3);color:var(--white);align-self:flex-start;border-left:2px solid var(--gold)}
.ai-msg.user{background:rgba(201,168,76,0.12);color:var(--white);align-self:flex-end;text-align:right}
.ai-msg.typing{color:var(--text-muted);font-style:italic}
#ai-suggestions{padding:0 16px 12px;display:flex;flex-wrap:wrap;gap:8px}
.ai-chip{background:var(--black-3);border:1px solid var(--gold-dim);color:var(--gold);font-size:12px;padding:7px 12px;border-radius:14px;cursor:pointer;transition:all .2s;font-family:'DM Sans',sans-serif}
.ai-chip:hover{background:var(--gold);color:var(--black)}
#ai-input-area{padding:12px;border-top:1px solid var(--border);display:flex;gap:8px}
#ai-input{flex:1;background:var(--black-3);border:1px solid var(--border);color:var(--white);padding:10px 12px;font-family:'DM Sans',sans-serif;font-size:13px;outline:none;transition:border-color .2s;border-radius:0}
#ai-input:focus{border-color:var(--gold)}
#ai-send{background:var(--gold);color:var(--black);border:none;width:40px;height:40px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;transition:background .2s;flex-shrink:0}
#ai-send:hover{background:var(--gold-light)}
#ai-send:disabled{opacity:.5;cursor:not-allowed}
#ai-footer-label{text-align:center;padding:7px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--text-muted);border-top:1px solid var(--border)}

@media(max-width:560px){
  #ai-widget{bottom:20px;right:20px}
  #ai-box{width:calc(100vw - 40px);right:0}
}

/* ============================================
   UTILITY
   ============================================ */
.container-narrow{max-width:820px}
.legal-content{padding:160px 6vw 100px;max-width:860px}
.legal-content h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,7vw,72px);color:var(--white-pure);letter-spacing:1px;margin-bottom:12px}
.legal-content .updated{font-size:13px;color:var(--text-muted);margin-bottom:40px}
.legal-content h2{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;color:var(--gold);margin:36px 0 14px}
.legal-content p{color:var(--text-muted);font-size:15px;line-height:1.8;margin-bottom:16px}
.legal-content ul{color:var(--text-muted);font-size:15px;line-height:1.8;margin:0 0 16px 24px}
.legal-content li{margin-bottom:8px}
.legal-content a{color:var(--gold)}

@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  .reveal,.reveal-left,.reveal-right{opacity:1;transform:none}
}
